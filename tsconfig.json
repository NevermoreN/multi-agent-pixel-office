{
  "compilerOptions": {
    "module": "Node16",
    "target": "ES2022",
    "lib": ["ES2022"],
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "Node16"
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "webview-ui",
    "src/agentStore.ts",
    "src/hooksServer.ts"
  ]
}
